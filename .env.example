# Desenvolvimento local apenas. Nunca use estas credenciais em produção.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pabula_acxel_dashboard?schema=public"
SESSION_SECRET="gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres"

# Chave usada para criptografar credenciais salvas em Admin > Integrações.
# Em produção, use uma chave aleatória estável com pelo menos 32 caracteres.
INTEGRATION_ENCRYPTION_KEY="gere-uma-chave-aleatoria-estavel-com-pelo-menos-32-caracteres"

# Appmax — o merchant é configurado em Admin > Integrações.
APPMAX_WEBHOOK_TOKEN="gere-outro-token-aleatorio-com-pelo-menos-32-caracteres"

# Asaas — API key e token do webhook são configurados em Admin > Integrações
# e protegidos usando as chaves estáveis acima.

# E-mail SMTP — preencha com os dados da caixa de e-mail da hospedagem.
SMTP_HOST="mail.vixpi.host"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="contato@pacelabcoaching.com"
SMTP_PASSWORD="senha-da-caixa-de-email"
EMAIL_FROM="Pace Lab <contato@pacelabcoaching.com>"
# Portais públicos. Enquanto o subdomínio dos alunos não estiver configurado,
# mantenha STUDENT_PORTAL_ENABLED="false" para preservar os fluxos atuais.
ADMIN_APP_URL="https://gestao.pacelabcoaching.com"
STUDENT_APP_URL="https://alunos.pacelabcoaching.com"
STUDENT_PORTAL_ENABLED="false"

# Compatibilidade com instalações anteriores. Pode ser removida depois que
# ADMIN_APP_URL estiver configurada em produção.
APP_URL="https://gestao.pacelabcoaching.com"
EMAIL_CRON_SECRET="gere-uma-chave-aleatoria-longa-para-o-cron"

# Seed de desenvolvimento: admin@pabula.com / Admin@123
# Seed de desenvolvimento: aluno@pabula.com / Aluno@123
