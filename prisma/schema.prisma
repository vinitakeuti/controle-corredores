generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
  STUDENT
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum PaymentMethod {
  PIX
  CARD
  BOLETO
}

enum PlanPeriod {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

enum ReminderType {
  UPCOMING
  DUE_TODAY
}

enum PaymentLinkStatus {
  OPEN
  COMPLETED
  REVOKED
}

enum GatewayEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum WorkAreaType {
  GENERAL
  SECTOR
}

enum DemandColumn {
  OPEN
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

model User {
  id                  String            @id @default(cuid())
  name                String
  email               String            @unique
  passwordHash        String
  passwordIsTemporary Boolean           @default(false)
  phone               String?
  cpf                 String?           @unique
  asaasCustomerId     String?           @unique
  birthDate           DateTime?
  role                UserRole          @default(STUDENT)
  active              Boolean           @default(true)
  joinedAt            DateTime          @default(now())
  leftAt              DateTime?
  tutorialSeenAt      DateTime?
  liabilityTermRequiredAt DateTime?
  liabilityTermAcceptedAt DateTime?
  liabilityTermAcceptedName String?
  liabilityTermAcceptedCpf String?
  liabilityTermVersion String?
  liabilityTermDocument String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  session             Session[]
  subscription        Subscription?
  payments            Payment[]
  renewalReminders    RenewalReminder[]
  passwordResetTokens PasswordResetToken[]
  emailDeliveries     EmailDelivery[]
  paymentLinks        PaymentLink[]     @relation("PaymentLinkStudent")
  createdPaymentLinks PaymentLink[]     @relation("PaymentLinkCreator")
  createdDemands     Demand[]           @relation("DemandCreator")
  demandAssignments  DemandAssignment[]

  @@index([role])
  @@index([joinedAt])
  @@index([leftAt])
}

model WorkArea {
  id        String       @id @default(cuid())
  name      String
  type      WorkAreaType @default(SECTOR)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  demands   Demand[]

  @@unique([name])
  @@index([type, name])
}

model Demand {
  id          String       @id @default(cuid())
  workAreaId  String
  createdById String
  title       String
  description String?
  column      DemandColumn @default(OPEN)
  position    Int          @default(0)
  scheduledAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  workArea    WorkArea     @relation(fields: [workAreaId], references: [id], onDelete: Cascade)
  createdBy   User         @relation("DemandCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignees   DemandAssignment[]

  @@index([workAreaId, column, position])
  @@index([scheduledAt])
}

model DemandAssignment {
  id        String   @id @default(cuid())
  demandId  String
  userId    String
  createdAt DateTime @default(now())
  demand    Demand   @relation(fields: [demandId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([demandId, userId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String             @unique
  status                 SubscriptionStatus @default(INCOMPLETE)
  planName               String             @default("Treinamento mensal")
  planId                 String?
  priceCents             Int                @default(15000)
  billingPeriod          PlanPeriod         @default(MONTHLY)
  hasCustomPrice         Boolean            @default(false)
  automaticPixEnabled    Boolean            @default(true)
  nextBillingAt          DateTime?
  providerCustomerId     String?
  providerSubscriptionId String?
  asaasPixAuthorizationId String?          @unique
  asaasPixAuthorizationStatus String?
  allowedMethods         PaymentMethod[]   @default([PIX, CARD, BOLETO])
  recurringEnabled       Boolean            @default(false)
  recurringMethod        PaymentMethod?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                   Plan?              @relation(fields: [planId], references: [id], onDelete: SetNull)
  payments               Payment[]

  @@index([status])
  @@index([nextBillingAt])
  @@index([planId])
}

model Payment {
  id                  String        @id @default(cuid())
  userId              String
  subscriptionId      String?
  paymentLinkId       String?
  requestKey          String?       @unique
  amountCents         Int
  installmentCount    Int           @default(1)
  status              PaymentStatus @default(PENDING)
  method              PaymentMethod
  dueAt               DateTime
  expiresAt           DateTime?
  paidAt              DateTime?
  recurringRequested  Boolean       @default(false)
  provider            String        @default("APPMAX")
  providerOrderId     String?
  providerPaymentId   String?
  providerStatus      String?
  checkoutUrl         String?
  pixCopyPaste        String?
  pixQrCode           String?
  boletoUrl           String?
  boletoDigitableLine String?
  lastError           String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription        Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  paymentLink         PaymentLink?  @relation(fields: [paymentLinkId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, dueAt])
  @@index([expiresAt])
  @@index([paymentLinkId])
  @@unique([provider, providerOrderId])
}

model GatewayEvent {
  id                     String             @id @default(cuid())
  provider               String             @default("APPMAX")
  eventKey               String             @unique
  eventName              String
  eventType              String
  providerOrderId        String?
  providerSubscriptionId String?
  providerCustomerId     String?
  amountCents            Int?
  occurredAt             DateTime?
  status                 GatewayEventStatus @default(RECEIVED)
  error                  String?
  receivedAt             DateTime           @default(now())
  processedAt            DateTime?

  @@index([provider, status, receivedAt])
  @@index([providerOrderId])
  @@index([providerSubscriptionId])
}

model RenewalReminder {
  id           String       @id @default(cuid())
  userId       String
  type         ReminderType
  scheduledFor DateTime
  sentAt       DateTime?
  createdAt    DateTime     @default(now())
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, scheduledFor])
  @@index([scheduledFor, sentAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model EmailDelivery {
  id        String   @id @default(cuid())
  type      String
  dedupeKey String   @unique
  recipient String
  userId    String?
  sentAt    DateTime?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, type])
  @@index([sentAt])
}

model PaymentLink {
  id          String            @id @default(cuid())
  tokenHash   String            @unique
  userId      String?
  createdById String
  status      PaymentLinkStatus @default(OPEN)
  planName    String            @default("Treinamento mensal")
  planId      String?
  amountCents Int               @default(15000)
  allowedMethods PaymentMethod[] @default([PIX, CARD, BOLETO])
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User?             @relation("PaymentLinkStudent", fields: [userId], references: [id], onDelete: SetNull)
  createdBy   User              @relation("PaymentLinkCreator", fields: [createdById], references: [id], onDelete: Restrict)
  plan        Plan?             @relation(fields: [planId], references: [id], onDelete: SetNull)
  payments    Payment[]

  @@index([userId, status])
  @@index([createdById, createdAt])
  @@index([planId])
}

model Service {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  plans     Plan[]

  @@index([active, name])
}

model Plan {
  id          String     @id @default(cuid())
  serviceId   String
  period      PlanPeriod
  priceCents  Int
  allowedMethods PaymentMethod[] @default([PIX, CARD, BOLETO])
  automaticPixEnabled Boolean @default(true)
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  service     Service    @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  subscriptions Subscription[]
  paymentLinks PaymentLink[]

  @@unique([serviceId, period])
  @@index([active, serviceId])
}

model BillingSettings {
  id                    String          @id @default("platform")
  basePriceCents        Int             @default(15000)
  defaultAllowedMethods PaymentMethod[] @default([PIX, CARD, BOLETO])
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

model PaymentIntegration {
  id                    String   @id @default(cuid())
  provider              String   @unique @default("APPMAX")
  isActive              Boolean  @default(false)
  environment           String   @default("sandbox")
  clientId              String?
  clientSecretEncrypted String?
  apiKeyEncrypted       String?
  webhookTokenHash      String?
  externalId            String?
  appId                 String?
  softDescriptor        String   @default("PACELAB")
  recurrenceEnabled     Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([updatedAt])
}
